{
  "info": {
    "name": "PoolUp API Tests",
    "description": "Lab 5: tests of the PoolUp REST API (users, rides, bookings, metrics). Start the API with `npm run dev`, then run the whole collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "rideId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "GET all users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "  pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          }
        },
        {
          "name": "POST new user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has an id\", function () {",
                  "  pm.expect(pm.response.json()).to.have.property(\"id\");",
                  "});",
                  "pm.test(\"Role is passenger\", function () {",
                  "  pm.expect(pm.response.json().role).to.eql(\"passenger\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nora Haddad\",\n  \"email\": \"nora.{{$guid}}@poolup.dev\",\n  \"role\": \"passenger\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST user with missing field (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Rides",
      "item": [
        {
          "name": "GET all rides",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "  pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rides",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rides"
              ]
            }
          }
        },
        {
          "name": "GET rides Paris to Lyon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Every ride goes from Paris to Lyon\", function () {",
                  "  pm.response.json().forEach(function (r) {",
                  "    pm.expect(r.from).to.eql(\"Paris\");",
                  "    pm.expect(r.to).to.eql(\"Lyon\");",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rides?from=Paris&to=Lyon",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rides"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "Paris"
                },
                {
                  "key": "to",
                  "value": "Lyon"
                }
              ]
            }
          }
        },
        {
          "name": "POST new ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has an id\", function () {",
                  "  pm.expect(pm.response.json()).to.have.property(\"id\");",
                  "});",
                  "// Remember this ride so the booking requests use a ride with free seats",
                  "pm.collectionVariables.set(\"rideId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rides",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rides"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": 1,\n  \"from\": \"Paris\",\n  \"to\": \"Nantes\",\n  \"date\": \"2026-12-01\",\n  \"seats\": 3,\n  \"price\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "GET all bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "  pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "POST new booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has an id\", function () {",
                  "  pm.expect(pm.response.json()).to.have.property(\"id\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": {{rideId}},\n  \"passengerId\": 3,\n  \"seats\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST booking on full ride (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409 Conflict\", function () {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": {{rideId}},\n  \"passengerId\": 3,\n  \"seats\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Metrics",
      "item": [
        {
          "name": "GET metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Has users, rides, bookings, seats and uptime\", function () {",
                  "  pm.expect(pm.response.json()).to.have.all.keys(\"users\", \"rides\", \"bookings\", \"seats\", \"uptime\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "metrics"
              ]
            }
          }
        }
      ]
    }
  ]
}